{
  "name": "drawback-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test tests/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "ci": "prettier --check . && eslint . && bun run typecheck && bun test tests/ && vite build"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.1.0"
  }
}
